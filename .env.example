# GCP Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json

# Qdrant Vector Database Configuration
# For Vertex AI text-embedding-004, use Dimension: 768, Distance: COSINE
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=enterprise_kb
QDRANT_TOP_K=5

# Vapi Conversational AI Configuration
VITE_VAPI_PUBLIC_KEY=your-vapi-public-key
VITE_VAPI_ASSISTANT_ID=your-vapi-assistant-id
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret

# Backend / General Configuration
PORT=3001
PYTHON_API_URL=http://localhost:8000/vapi-webhook
